# Allow direct access to images
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

# Only allow image files
<FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Block all other files
<FilesMatch "^(?!.*\.(jpg|jpeg|png|gif|webp)$)">
    Order Deny,Allow
    Deny from all
</FilesMatch>
