# Allow direct access to images and videos
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

# Allow image and video files
<FilesMatch "\.(jpg|jpeg|png|gif|webp|mp4|webm|mov|avi)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Block all other files
<FilesMatch "^(?!.*\.(jpg|jpeg|png|gif|webp|mp4|webm|mov|avi)$)">
    Order Deny,Allow
    Deny from all
</FilesMatch>
